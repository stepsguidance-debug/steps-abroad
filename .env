# ============================================================
#  STEPS GUIDANCE — ENVIRONMENT CONFIGURATION
#  E:\personal_project\studies\steps-abroad\.env
# ============================================================

# ────────────────────────────────────────────────────────────
#  MONGODB ATLAS
#  Both databases live on the same cluster.
#  The database name is appended in code — do not add it here.
# ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://stepsguidance_db_user:piKUitXK8CO8Acjw@ac-dva0zn3-shard-00-00.sgzr03l.mongodb.net:27017,ac-dva0zn3-shard-00-01.sgzr03l.mongodb.net:27017,ac-dva0zn3-shard-00-02.sgzr03l.mongodb.net:27017/?ssl=true&replicaSet=atlas-xh8kdz-shard-0&authSource=admin&appName=Cluster0

# Database names (used in server/db.js to create two connections)
DB_ADMIN=stepsguidance_admin
DB_STUDENTS=stepsguidance_students

# ────────────────────────────────────────────────────────────
#  GEMINI API
#  Get your key from https://aistudio.google.com/app/apikey
# ────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyD2k72wT9hYglFtHy93dTXwVHswD8oPRoI

# ── Model used for full student scoring ──────────────────────
#  Handles: trait scores, behaviour profile, AI readiness index,
#  contradiction flags, career mapping, degree suggestions,
#  job role suggestions, and the AI summary paragraph.
#  To upgrade or downgrade, change only this line.
#  Available options:
#    gemini-2.5-pro          ← current (best reasoning, use this)
#    gemini-2.5-flash        ← faster, cheaper, slightly less accurate
#    gemini-2.0-flash        ← deprecated June 1 2026, do not use
#    gemini-1.5-pro          ← older, still works
GEMINI_MODEL_PRO=gemini-2.5-pro

# ── Model used for AI risk check per job role ─────────────────
#  Handles: real-time Google Search grounding per job role,
#  returns aiRisk (safe / at-risk / high-risk), whatAiIsDoing,
#  whatStudentShouldDo for each role in primary and secondary fit.
#  To change model, update only this line.
#  Available options:
#    gemini-2.5-flash        ← current (fast + search grounding)
#    gemini-2.5-pro          ← slower + more expensive for this task
#    gemini-2.0-flash        ← deprecated June 1 2026, do not use
GEMINI_MODEL_FLASH=gemini-2.5-flash

# ── Model used for AI summary paragraph ──────────────────────
#  Handles: the final one-paragraph personalised suggestion
#  shown at the bottom of the student result dashboard.
#  Currently same as flash to save cost. Change independently if needed.
#  Available options: same as GEMINI_MODEL_FLASH above
GEMINI_MODEL_SUMMARY=gemini-2.5-flash

# ────────────────────────────────────────────────────────────
#  GEMINI RATE LIMITS (Free Tier — do not exceed these)
#  These are display-only for the System Status page.
#  The queue delay below is what actually enforces the limit.
#
#  gemini-2.5-pro:   2 RPM,  50 RPD,  32,000 TPM
#  gemini-2.5-flash: 10 RPM, 500 RPD, 250,000 TPM
#
#  Each student submission uses:
#    1 × GEMINI_MODEL_PRO call (full scoring)
#    6 × GEMINI_MODEL_FLASH calls (3 primary + 3 secondary job roles)
#    1 × GEMINI_MODEL_SUMMARY call (summary paragraph)
#  Total per submission: 1 Pro + 7 Flash calls
# ────────────────────────────────────────────────────────────

# Delay in milliseconds between queued student submissions.
# Set to 35000 (35 seconds) in production to respect the 2 RPM
# limit on gemini-2.5-pro. Set to 2000 during local development
# to avoid waiting. Never set below 1000.
#   Production:  35000
#   Development: 2000
GEMINI_QUEUE_DELAY_MS=2000

# Maximum number of students allowed in the queue at one time.
# If the queue is full, new submissions are rejected with a
# "Server busy, please try again in a few minutes" message.
GEMINI_QUEUE_MAX_SIZE=10

# ────────────────────────────────────────────────────────────
#  JWT AUTHENTICATION
#  Used to sign and verify login tokens for admin and students.
#  Change JWT_SECRET to any long random string in production.
#  JWT_EXPIRES_IN controls how long a login session lasts.
# ────────────────────────────────────────────────────────────
JWT_SECRET=stepsguidance_jwt_secret_2024_changeme_in_production
JWT_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────────
#  SERVER
# ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ────────────────────────────────────────────────────────────
#  FRONTEND (Vite)
#  Variables starting with VITE_ are exposed to the browser.
#  Never put secrets in VITE_ variables.
# ────────────────────────────────────────────────────────────

# Backend API base URL used by the React frontend.
# Development: http://localhost:5000
# Production (Vercel): https://your-deployed-backend-url.vercel.app
VITE_API_BASE_URL=
FRONTEND_URL=https://steps-abroad.vercel.app
CLIENT_ORIGIN=https://steps-abroad.vercel.app
# App name shown in the browser tab and header
VITE_APP_NAME=Steps Guidance
